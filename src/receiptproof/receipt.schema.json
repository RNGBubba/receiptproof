{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RNGBubba/receiptproof/blob/main/src/receiptproof/receipt.schema.json",
  "title": "ReceiptProof artifact receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "code_sha", "command", "exit_code", "artifact", "recorded_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "code_sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "command": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "exit_code": { "type": "integer" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "recorded_at": { "type": "string", "format": "date-time" }
  }
}
